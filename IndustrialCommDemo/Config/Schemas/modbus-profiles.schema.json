{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Modbus device profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [ "profiles" ],
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "key", "displayName", "defaultAddress", "exampleAddresses", "addressPattern", "lowWordFirst", "mappings" ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "defaultAddress": { "type": "string", "minLength": 1 },
          "exampleAddresses": { "type": "string", "minLength": 1 },
          "addressPattern": { "type": "string", "minLength": 1 },
          "lowWordFirst": { "type": "boolean" },
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "prefix", "area", "base", "max", "radix" ],
              "properties": {
                "prefix": { "type": "string", "minLength": 1 },
                "area": { "type": "string", "enum": [ "Coil", "DiscreteInput", "InputRegister", "HoldingRegister" ] },
                "base": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "max": { "type": "integer", "minimum": 1, "maximum": 65536 },
                "radix": { "type": "string", "enum": [ "decimal", "hex", "octal" ] }
              }
            }
          }
        }
      }
    }
  }
}
