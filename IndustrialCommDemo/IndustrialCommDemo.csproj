<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\industrial-comm-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\industrial-comm-icon.png" />
    <Content Include="Assets\industrial-comm-icon.ico" />
    <Content Include="Config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndustrialCommSdk\IndustrialCommSdk.csproj" />
    <ProjectReference Include="..\IndustrialCommSdk.Storage.MySql\IndustrialCommSdk.Storage.MySql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <PropertyGroup>
    <Snap7ServerProject>$(MSBuildThisFileDirectory)..\IndustrialCommDemo.Snap7Server\IndustrialCommDemo.Snap7Server.csproj</Snap7ServerProject>
    <Snap7ServerOutput>$(MSBuildThisFileDirectory)..\IndustrialCommDemo.Snap7Server\bin\$(Configuration)\net472\</Snap7ServerOutput>
  </PropertyGroup>

  <!-- Keep the optional x86 Snap7 sidecar next to the Demo executable so the
       Siemens S7 page can start it without requiring a separate install step. -->
  <Target Name="BuildAndCopySnap7Server" AfterTargets="Build" Condition="Exists('$(Snap7ServerProject)')">
    <MSBuild Projects="$(Snap7ServerProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=x86" />
    <ItemGroup>
      <Snap7ServerFiles Include="$(Snap7ServerOutput)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(Snap7ServerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
