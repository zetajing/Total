<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationIcon>Assets\industrial-comm-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\industrial-comm-icon.png" />
    <Content Include="Assets\industrial-comm-icon.ico" />
    <Content Include="Config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndustrialCommSdk\IndustrialCommSdk.csproj" />
    <ProjectReference Include="..\IndustrialCommSdk.Protocols.Ads\IndustrialCommSdk.Protocols.Ads.csproj" />
    <ProjectReference Include="..\IndustrialCommSdk.Storage.MySql\IndustrialCommSdk.Storage.MySql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <Snap7ServerProject>$(MSBuildThisFileDirectory)..\IndustrialCommDemo.Snap7Server\IndustrialCommDemo.Snap7Server.csproj</Snap7ServerProject>
    <Snap7ServerOutput>$(MSBuildThisFileDirectory)..\IndustrialCommDemo.Snap7Server\bin\$(Configuration)\net8.0\</Snap7ServerOutput>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- Keep the optional x86 Snap7 sidecar next to the Demo executable so the
       virtual PLC page can start it without requiring a separate install step. -->
  <Target Name="BuildAndCopySnap7Server" AfterTargets="Build" Condition="Exists('$(Snap7ServerProject)')">
    <MSBuild Projects="$(Snap7ServerProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=x86;TargetFramework=net8.0;RuntimeIdentifier=;SelfContained=false;PublishSingleFile=false;PublishReadyToRun=false;PublishProfile=" />
    <ItemGroup>
      <Snap7ServerFiles Include="$(Snap7ServerOutput)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(Snap7ServerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish the x86 helper with its own self-contained runtime in a
       subdirectory. Keeping it separate prevents x86 and x64 runtime files
       from colliding in the main application's publish directory. -->
  <Target Name="PublishSnap7Server" AfterTargets="Publish" Condition="Exists('$(Snap7ServerProject)') and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_Snap7ServerPublishDirectory>$(PublishDir)snap7server\</_Snap7ServerPublishDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(_Snap7ServerPublishDirectory)" />
    <MSBuild Projects="$(Snap7ServerProject)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);Platform=x86;TargetFramework=net8.0;RuntimeIdentifier=win-x86;SelfContained=true;PublishSingleFile=false;PublishReadyToRun=false;PublishProfile=;PublishDir=$(_Snap7ServerPublishDirectory)" />
  </Target>

</Project>
