<UserControl x:Class="IndustrialCommDemo.Views.OpcUaTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="连接" Grid.Column="0" Margin="0,0,12,0">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="设备 ID" />
                    <TextBox x:Name="DeviceIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,6" Text="opcua-1" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="Endpoint URL" />
                    <TextBox x:Name="EndpointUrlTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Text="opc.tcp://127.0.0.1:4840" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="用户名（可选）" />
                    <TextBox x:Name="UsernameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="密码（本次连接）" />
                    <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,6" />
                    <CheckBox x:Name="UseSecurityCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,2" Content="使用 OPC UA 安全 Endpoint" />
                    <CheckBox x:Name="AutoAcceptCertificatesCheckBox" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,2,0,8" Content="接受未受信证书（仅建议开发/测试使用）" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="连接超时（毫秒）" />
                    <TextBox x:Name="ConnectTimeoutTextBox" Grid.Row="6" Grid.Column="1" Margin="0,6" Text="10000" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="操作超时（毫秒）" />
                    <TextBox x:Name="OperationTimeoutTextBox" Grid.Row="7" Grid.Column="1" Margin="0,6" Text="5000" />
                    <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="会话超时（毫秒）" />
                    <TextBox x:Name="SessionTimeoutTextBox" Grid.Row="8" Grid.Column="1" Margin="0,6" Text="60000" />

                    <Border Grid.Row="9" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10" CornerRadius="10" Background="#F8FAFC" BorderBrush="#D8E2EE" BorderThickness="1">
                        <TextBlock x:Name="CapabilityTextBlock" TextWrapping="Wrap" Foreground="#475569" Text="协议能力：等待初始化。" />
                    </Border>
                    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Width="120" Margin="0,0,12,0" Padding="10" Background="#1D4ED8" Foreground="White" BorderThickness="0" Click="ConnectButton_Click" Content="连接" />
                        <Button Width="120" Margin="0,0,12,0" Padding="10" Background="#334155" Foreground="White" BorderThickness="0" Click="DisconnectButton_Click" Content="断开" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="状态：" />
                        <TextBlock x:Name="StatusTextBlock" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#0F766E" Text="未连接" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="节点读写" Grid.Column="1">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="NodeId" />
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBox x:Name="NodeIdTextBox" Margin="0,6" Text="ns=2;s=Machine/Temperature" />
                        <ComboBox x:Name="NodeIdHistoryComboBox" Margin="0,0,0,6" SelectionChanged="NodeIdHistoryComboBox_SelectionChanged" />
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Foreground="#5B6F82" Text="示例：ns=2;s=Machine/Temperature 或 ns=2;i=1001" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="数据类型" />
                    <ComboBox x:Name="DataTypeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,6" SelectedIndex="1">
                        <ComboBoxItem Content="Bool" /><ComboBoxItem Content="Byte" /><ComboBoxItem Content="Char" />
                        <ComboBoxItem Content="Int16" /><ComboBoxItem Content="UInt16" /><ComboBoxItem Content="Int32" />
                        <ComboBoxItem Content="UInt32" /><ComboBoxItem Content="Float" /><ComboBoxItem Content="Double" />
                        <ComboBoxItem Content="String" /><ComboBoxItem Content="ByteArray" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="长度" />
                    <TextBox x:Name="LengthTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Text="1" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="写入值" />
                    <TextBox x:Name="WriteValueTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Text="123" />
                    <UniformGrid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,14,0,0" Columns="2">
                        <Button Margin="0,0,8,8" Padding="10" Background="#0891B2" Foreground="White" BorderThickness="0" Click="ReadButton_Click" Content="读取节点" />
                        <Button Margin="8,0,0,8" Padding="10" Background="#059669" Foreground="White" BorderThickness="0" Click="WriteButton_Click" Content="写入节点" />
                    </UniformGrid>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12" CornerRadius="12" Background="#F8FAFC" BorderBrush="#D8E2EE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#17324D" Text="结果" />
                            <TextBlock x:Name="ResultTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#334155" Text="等待中..." />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#64748B" Text="密码不会保存到 Demo 状态文件。写入前请确认 NodeId、数据类型和目标设备状态。" />
                </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
