<UserControl x:Class="IndustrialCommDemo.Views.NetworkServicesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldControlStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
        </Style>
        <Style x:Key="LogBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Resources>

    <TabControl x:Name="NetworkServicesTabControl" Background="Transparent" BorderThickness="0">
        <TabItem Header="MQTT 客户端 / Broker">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Column="0" Margin="0,0,6,8" Header="内嵌 MQTT Broker（默认关闭）">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="监听地址" />
                            <TextBox x:Name="MqttBindAddressTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="明文端口" />
                            <TextBox x:Name="MqttPortTextBox" Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldControlStyle}" />

                            <CheckBox x:Name="MqttUseTlsCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,9,0,4" Content="启用 TLS（远程监听必需）" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="TLS 端口" />
                            <TextBox x:Name="MqttTlsPortTextBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldControlStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="证书指纹" />
                            <TextBox x:Name="MqttCertificateTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldControlStyle}" ToolTip="从 CurrentUser/LocalMachine 的 My 证书库读取，必须包含私钥。" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                            <TextBox x:Name="MqttUsernameTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="密码" />
                            <PasswordBox x:Name="MqttBrokerPasswordBox" Grid.Row="3" Grid.Column="3" Margin="0,4" ToolTip="留空表示保留 DPAPI 中已保存的密码。" />
                            <CheckBox x:Name="MqttAutoStartCheckBox" Grid.Row="4" Grid.ColumnSpan="4" Margin="0,8,0,4" Content="程序启动时自动启动 Broker" />
                            <Border Grid.Row="5" Grid.ColumnSpan="4" Margin="0,6,0,8" Padding="9" Background="#FFF4CE" BorderBrush="#F2D675" BorderThickness="1" CornerRadius="5">
                                <TextBlock Foreground="#5C4400" TextWrapping="Wrap" Text="默认仅监听 127.0.0.1。远程监听必须启用 TLS；密码通过 Windows DPAPI 保存，不写入 JSON。" />
                            </Border>
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButtonStyle}" Click="SaveMqttButton_Click" Content="保存安全配置" />
                                <Button Margin="0,0,8,0" Click="ValidateNetworkConfigurationButton_Click" Content="校验 JSON" />
                                <Button Margin="0,0,8,0" Click="RestoreNetworkTemplateButton_Click" Content="恢复模板" />
                                <Button Margin="0,0,8,0" Click="StartMqttButton_Click" Content="启动 Broker" />
                                <Button Margin="0,0,8,0" Click="StopMqttButton_Click" Content="停止 Broker" />
                                <Button Click="RefreshMqttClientsButton_Click" Content="刷新客户端" />
                            </StackPanel>
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="运行状态" />
                            <TextBlock x:Name="MqttBrokerStatusTextBlock" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,4" Foreground="IndianRed" Text="已停止" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Margin="6,0,0,8" Header="MQTT 调试客户端">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="主机" />
                            <TextBox x:Name="MqttClientHostTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldControlStyle}" Text="127.0.0.1" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="端口" />
                            <TextBox x:Name="MqttClientPortTextBox" Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldControlStyle}" Text="1883" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Client ID" />
                            <TextBox x:Name="MqttClientIdTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldControlStyle}" Text="desktop-debug" />
                            <CheckBox x:Name="MqttClientTlsCheckBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,9,0,4" Content="TLS" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                            <TextBox x:Name="MqttClientUsernameTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldControlStyle}" Text="industrial" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="密码" />
                            <PasswordBox x:Name="MqttClientPasswordBox" Grid.Row="2" Grid.Column="3" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="订阅 Topic" />
                            <TextBox x:Name="MqttSubscribeTopicTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldControlStyle}" Text="industrial/v1/devices/#" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="发布 Topic" />
                            <TextBox x:Name="MqttPublishTopicTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldControlStyle}" Text="industrial/v1/requests/desktop-debug/read" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="消息" />
                            <TextBox x:Name="MqttPayloadTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Text="{}{&quot;correlationId&quot;:&quot;demo-1&quot;,&quot;items&quot;:[]}" />
                            <WrapPanel Grid.Row="6" Grid.ColumnSpan="4" Margin="0,8,0,4">
                                <Button Style="{StaticResource ActionButtonStyle}" Click="ConnectMqttClientButton_Click" Content="连接" />
                                <Button Margin="0,0,8,0" Click="DisconnectMqttClientButton_Click" Content="断开" />
                                <Button Margin="0,0,8,0" Click="SubscribeMqttButton_Click" Content="订阅" />
                                <Button Click="PublishMqttButton_Click" Content="发布" />
                            </WrapPanel>
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="客户端状态" />
                            <TextBlock x:Name="MqttClientStatusTextBlock" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,4" Foreground="IndianRed" Text="未连接" />
                            <TextBox x:Name="MqttClientLogTextBox" Grid.Row="8" Grid.ColumnSpan="4" Height="100" Margin="0,6,0,0" Style="{StaticResource LogBoxStyle}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Broker 客户端与消息">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <DataGrid x:Name="MqttBrokerClientsDataGrid" Grid.Column="0" Margin="0,0,6,0" Height="145" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}" Width="*" />
                                    <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="110" />
                                    <DataGridTextColumn Header="远端" Binding="{Binding Endpoint}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox x:Name="MqttBrokerLogTextBox" Grid.Column="1" Height="145" Margin="6,0,0,0" Style="{StaticResource LogBoxStyle}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="HTTP / WebAPI">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Margin="0,0,6,8" Header="WebAPI / WebSocket 网关（默认关闭）">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="监听前缀" />
                            <TextBox x:Name="WebListenPrefixTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="API Key" />
                            <PasswordBox x:Name="WebApiKeyPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,4" ToolTip="留空表示保留 DPAPI 中已保存的 API Key。" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Origin 白名单" />
                            <TextBox x:Name="WebOriginsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4" MinHeight="55" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="每行一个 Origin；远程监听时不能为空。" />
                            <CheckBox x:Name="WebEnableWritesCheckBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,3" Content="允许远程写入（点位还必须 writable=true）" />
                            <CheckBox x:Name="WebAllowRawReadsCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,3" Content="允许原始地址读取（默认关闭）" />
                            <CheckBox x:Name="WebExposeAddressesCheckBox" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,3" Content="在结果中公开底层地址" />
                            <CheckBox x:Name="WebAutoStartCheckBox" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,3,0,8" Content="程序启动时自动启动 Web 网关" />
                            <Border Grid.Row="7" Grid.ColumnSpan="2" Margin="0,4,0,8" Padding="9" Background="#E8F2FF" BorderBrush="#B8D8F8" BorderThickness="1" CornerRadius="5">
                                <TextBlock Foreground="#174A73" TextWrapping="Wrap" Text="非本机监听必须使用 HTTPS/WSS、API Key 和 Origin 白名单。远程地址可能需要管理员配置 HTTP.sys URL ACL 与证书绑定；本程序只检查并提示，不会自动执行 netsh。" />
                            </Border>
                            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButtonStyle}" Click="SaveWebButton_Click" Content="保存安全配置" />
                                <Button Margin="0,0,8,0" Click="StartWebButton_Click" Content="启动" />
                                <Button Margin="0,0,8,0" Click="StopWebButton_Click" Content="停止" />
                                <Button Click="HealthWebButton_Click" Content="健康测试" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Margin="6,0,0,8" Header="通用 HTTP / HTTPS 请求">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="方法" />
                            <ComboBox x:Name="HttpMethodComboBox" Grid.Row="0" Grid.Column="1" Margin="0,4" SelectedIndex="0">
                                <ComboBoxItem Content="GET" /><ComboBoxItem Content="POST" /><ComboBoxItem Content="PUT" />
                                <ComboBoxItem Content="PATCH" /><ComboBoxItem Content="DELETE" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="URL" />
                            <TextBox x:Name="HttpUrlTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldControlStyle}" Text="http://127.0.0.1:8088/api/v1/health" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="JSON 正文" />
                            <TextBox x:Name="HttpBodyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" Text="{}{&quot;correlationId&quot;:&quot;demo-1&quot;,&quot;items&quot;:[]}" />
                            <CheckBox x:Name="HttpUseSavedApiKeyCheckBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,4" IsChecked="True" Content="使用 DPAPI 中保存的 X-Industrial-Api-Key" />
                            <Button Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,8" Style="{StaticResource ActionButtonStyle}" Click="SendHttpButton_Click" Content="发送请求" />
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                                <TextBlock x:Name="WebGatewayStatusTextBlock" Margin="0,0,0,6" Foreground="IndianRed" Text="网关已停止" />
                                <TextBox x:Name="HttpLogTextBox" Height="190" Style="{StaticResource LogBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="WebSocket">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Margin="0,0,6,8" Header="WebSocket 调试客户端">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="WebSocket URL" />
                            <TextBox x:Name="WebSocketUrlTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldControlStyle}" Text="ws://127.0.0.1:8088/ws/v1/tags" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="API Key" />
                            <PasswordBox x:Name="WebSocketApiKeyPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,4" ToolTip="留空时使用 DPAPI 中保存的 Web API Key。" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Origin" />
                            <TextBox x:Name="WebSocketOriginTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="发送文本" />
                            <TextBox x:Name="WebSocketMessageTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Text="{}{&quot;type&quot;:&quot;ping&quot;,&quot;correlationId&quot;:&quot;demo-1&quot;}" />
                            <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,4">
                                <Button Style="{StaticResource ActionButtonStyle}" Click="ConnectWebSocketButton_Click" Content="连接" />
                                <Button Margin="0,0,8,0" Click="DisconnectWebSocketButton_Click" Content="断开" />
                                <Button Click="SendWebSocketButton_Click" Content="发送文本" />
                            </WrapPanel>
                            <TextBlock x:Name="WebSocketClientStatusTextBlock" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="IndianRed" Text="未连接" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Margin="6,0,0,8" Header="服务端会话">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Button Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" Click="RefreshWebSocketSessionsButton_Click" Content="刷新会话" />
                            <DataGrid x:Name="WebSocketSessionsDataGrid" Grid.Row="1" Height="230" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="会话 ID" Binding="{Binding Id}" Width="*" />
                                    <DataGridTextColumn Header="远端" Binding="{Binding RemoteEndpoint}" Width="150" />
                                    <DataGridTextColumn Header="连接时间(UTC)" Binding="{Binding ConnectedUtc}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="收发日志">
                        <TextBox x:Name="WebSocketLogTextBox" Height="180" Margin="10" Style="{StaticResource LogBoxStyle}" />
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="FTP / FTPS">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Margin="0,0,6,8" Header="外部 FTP / FTPS 服务器连接">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="服务器" />
                            <TextBox x:Name="FtpHostTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="端口" />
                            <TextBox x:Name="FtpPortTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                            <TextBox x:Name="FtpUsernameTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="密码" />
                            <PasswordBox x:Name="FtpPasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,4" ToolTip="留空表示保留 DPAPI 中已保存的密码。" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="远端根目录" />
                            <TextBox x:Name="FtpRootTextBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <CheckBox x:Name="FtpUseTlsCheckBox" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,3" Content="使用显式 FTPS（推荐）" />
                            <CheckBox x:Name="FtpAllowPlainCheckBox" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,3" Content="明确允许不安全的明文 FTP" />
                            <CheckBox x:Name="FtpPassiveCheckBox" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,3,0,8" Content="被动模式" />
                            <StackPanel Grid.Row="8" Grid.ColumnSpan="2">
                                <Border Margin="0,0,0,8" Padding="9" Background="#FFF4CE" BorderBrush="#F2D675" BorderThickness="1" CornerRadius="5">
                                    <TextBlock Foreground="#5C4400" TextWrapping="Wrap" Text="这里只连接外部 IIS/FileZilla 等标准服务器，不内嵌或启动 FTP Server；SFTP 属于 SSH 协议，不在此页支持。" />
                                </Border>
                                <WrapPanel>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="SaveFtpButton_Click" Content="保存配置" />
                                    <Button Margin="0,0,8,0" Click="ConnectFtpButton_Click" Content="连接" />
                                    <Button Click="DisconnectFtpButton_Click" Content="断开" />
                                </WrapPanel>
                                <TextBlock x:Name="FtpStatusTextBlock" Margin="0,10,0,0" Foreground="IndianRed" Text="未连接" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Margin="6,0,0,8" Header="文件操作">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="远端路径" />
                            <TextBox x:Name="FtpRemotePathTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldControlStyle}" Text="/" />
                            <WrapPanel Grid.Row="0" Grid.Column="2" Margin="8,4,0,4">
                                <Button Margin="0,0,6,0" Click="ListFtpButton_Click" Content="刷新列表" />
                                <Button Click="CreateFtpDirectoryButton_Click" Content="创建目录" />
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="本地文件" />
                            <TextBox x:Name="FtpLocalPathTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="8,4,0,4" Click="BrowseFtpLocalButton_Click" Content="浏览…" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="目标/新名称" />
                            <TextBox x:Name="FtpTargetPathTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldControlStyle}" />
                            <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,6">
                                <Button Style="{StaticResource ActionButtonStyle}" Click="UploadFtpButton_Click" Content="上传" />
                                <Button Margin="0,0,8,0" Click="DownloadFtpButton_Click" Content="下载" />
                                <Button Margin="0,0,8,0" Click="DeleteFtpButton_Click" Content="删除文件" />
                                <Button Margin="0,0,8,0" Click="RenameFtpButton_Click" Content="改名/移动" />
                                <Button Click="CancelFtpTransferButton_Click" Content="取消传输" />
                            </WrapPanel>
                            <ProgressBar x:Name="FtpProgressBar" Grid.Row="4" Grid.ColumnSpan="3" Height="16" Margin="0,4" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="FtpProgressTextBlock" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,3,0,6" Foreground="{StaticResource TextSecondaryBrush}" Text="等待操作" />
                            <DataGrid x:Name="FtpItemsDataGrid" Grid.Row="6" Grid.ColumnSpan="3" Height="230" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FtpItemsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100" />
                                    <DataGridTextColumn Header="修改时间(UTC)" Binding="{Binding ModifiedUtc}" Width="165" />
                                    <DataGridTextColumn Header="路径" Binding="{Binding RemotePath}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
