{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Industrial point table",
  "type": "object",
  "additionalProperties": false,
  "required": [ "tags" ],
  "properties": {
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "address", "type" ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "type": {
            "oneOf": [
              { "type": "string", "enum": [ "Bool", "SByte", "Byte", "Char", "Int16", "UInt16", "Int32", "UInt32", "Int64", "UInt64", "Float", "Double", "String", "WString", "S7String", "ByteArray", "Time", "LTime", "TimeOfDay", "Date", "DateTime" ] },
              { "type": "string", "pattern": "^STRING\\[[1-9][0-9]{0,2}\\]$" },
              { "type": "string", "pattern": "^WSTRING\\[[1-9][0-9]*\\]$" }
            ]
          },
          "length": { "type": "integer", "minimum": 1 },
          "writable": { "type": "boolean" }
        }
      }
    }
  }
}
