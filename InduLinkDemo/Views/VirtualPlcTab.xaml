<UserControl x:Class="InduLinkDemo.Views.VirtualPlcTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:InduLinkDemo.Views">
    <TabControl Margin="6" Background="Transparent" BorderThickness="0">
        <TabItem Header="Siemens S7">
            <views:Snap7ServerTab x:Name="S7ServerControl" />
        </TabItem>
        <TabItem Header="Modbus TCP">
            <views:ProtocolSimulatorTab x:Name="ModbusServerControl" />
        </TabItem>
        <TabItem Header="OPC UA">
            <views:ProtocolSimulatorTab x:Name="OpcUaServerControl" />
        </TabItem>
    </TabControl>
</UserControl>
