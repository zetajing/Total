<UserControl x:Class="InduLinkDemo.Views.DeviceRuntimeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="设备运行中心" />
                    <TextBlock x:Name="RuntimeStatusTextBlock" Margin="0,5,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="加载 Config/devices.json 后可统一启动设备。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton" Margin="0,0,8,0" Click="ReloadButton_Click" Content="重新加载配置" />
                    <Button x:Name="StartButton" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"
                            Click="StartButton_Click" Content="启动全部设备" />
                    <Button x:Name="StopButton" Style="{StaticResource SubtleDangerButtonStyle}"
                            Click="StopButton_Click" Content="停止" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="{StaticResource AccentSubtleBrush}" CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource AccentBrush}" Text="&#xE77B;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock x:Name="DeviceCountTextBlock" FontSize="22" FontWeight="SemiBold" Text="0" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="启用设备" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="{StaticResource SuccessSubtleBrush}" CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource SuccessBrush}" Text="&#xE701;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock x:Name="ConnectedCountTextBlock" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" Text="0" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="在线设备" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="{StaticResource DangerSubtleBrush}" CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource DangerBrush}" Text="&#xE783;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock x:Name="IssueCountTextBlock" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}" Text="0" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="异常设备" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="{StaticResource WarningSubtleBrush}" CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource WarningBrush}" Text="&#xE943;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock x:Name="PointCountTextBlock" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" Text="0" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="实时点位" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <GroupBox Grid.Row="2" Margin="0,10,0,0" Header="设备状态">
            <DataGrid x:Name="DeviceGrid" MinHeight="116" MaxHeight="260"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="150" Header="设备" Binding="{Binding Name}" />
                    <DataGridTextColumn Width="140" Header="协议" Binding="{Binding Protocol}" />
                    <DataGridTextColumn Width="180" Header="地址" Binding="{Binding Endpoint}" />
                    <DataGridTemplateColumn Width="120" Header="状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{Binding State}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="*" Header="最近错误" Binding="{Binding Error}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Margin="0,10,0,0" Header="实时点位">
            <DataGrid x:Name="ValueGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="120" Header="设备" Binding="{Binding DeviceName}" />
                    <DataGridTextColumn Width="150" Header="点位" Binding="{Binding TagName}" />
                    <DataGridTextColumn Width="140" Header="地址" Binding="{Binding Address}" />
                    <DataGridTextColumn Width="160" Header="值" Binding="{Binding Value}" />
                    <DataGridTemplateColumn Width="110" Header="质量">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource QualityBadgeBorderStyle}">
                                    <TextBlock Style="{StaticResource QualityBadgeTextStyle}" Text="{Binding Quality}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="180" Header="时间" Binding="{Binding Timestamp}" />
                    <DataGridTextColumn Width="*" Header="错误" Binding="{Binding Error}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
